# Build command (run this from the project root):
# docker build --network host -t frontend-builder:latest -f frontend/Dockerfile.build .

FROM node:22-slim

RUN corepack enable

WORKDIR /app/frontend

COPY frontend/package.json frontend/pnpm-workspace.yaml* frontend/.npmrc* frontend/pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --frozen-lockfile
